<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Nécessaire depuis Android 11 pour voir toutes les applications installées. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Visionneuse : télécharge les photos et vidéos servies par le téléphone. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- « Voir la TV » avec le son : capture du son des applications (accordée par ADB). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:label="OmniZap (aide)"
        android:usesCleartextTraffic="true">

        <!-- Visionneuse plein écran, lancée par le téléphone par ADB (sans icône). -->
        <activity
            android:name=".Viewer"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Duplication de l'écran du téléphone (vidéo H.264 reçue du téléphone). -->
        <activity
            android:name=".Mirror"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Son de la TV vers le téléphone : autorisation (invisible), puis service de capture. -->
        <activity
            android:name=".TvAudio"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".AudioCapture"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

    <instrumentation
        android:name=".AppLister"
        android:label="Liste des applications"
        android:targetPackage="io.github.itlearner0.tvremote.helper" />
</manifest>
