<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingBottom="4dp"
        android:textColor="#EEF0F4"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_power"
            style="@style/WidgetButton"
            android:background="@drawable/widget_button_power"
            android:contentDescription="Marche"
            android:src="@drawable/ic_q_power" />

        <ImageButton
            android:id="@+id/widget_vol_down"
            style="@style/WidgetButton"
            android:contentDescription="Volume moins"
            android:src="@drawable/ic_q_vol_down" />

        <ImageButton
            android:id="@+id/widget_vol_up"
            style="@style/WidgetButton"
            android:contentDescription="Volume plus"
            android:src="@drawable/ic_q_vol_up" />

        <ImageButton
            android:id="@+id/widget_mute"
            style="@style/WidgetButton"
            android:contentDescription="Muet"
            android:src="@drawable/ic_q_mute" />

        <ImageButton
            android:id="@+id/widget_play"
            style="@style/WidgetButton"
            android:contentDescription="Lecture ou pause"
            android:src="@drawable/ic_q_play_pause" />
    </LinearLayout>
</LinearLayout>
